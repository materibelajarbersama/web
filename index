:root{--bg:#f3f7fc;--panel:#ffffff;--panel2:#edf4fb;--line:#d6e0ed;--text:#17253b;--muted:#607089;--cyan:#087f8c;--blue:#4568d4;--gold:#a66a00;--red:#b42345;--green:#18794e}
body{background:radial-gradient(ellipse at top,#e4f5fb 0%,var(--bg) 58%);color:var(--text)}
.pill{background:#f8fbff}
.panel{background:linear-gradient(180deg,rgba(255,255,255,.99),rgba(248,251,255,.99));box-shadow:0 12px 35px #243c5a12}
.topic{color:var(--muted)}.topic.active{background:#e2f2fa;border-color:#9acddd;color:#163b56}
