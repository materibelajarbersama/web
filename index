<style>
:root{--bg:#0b1020;--panel:#131b30;--panel2:#19233b;--line:#2b3958;--text:#edf3ff;--muted:#a8b5d2;--cyan:#62e6df;--blue:#8aa7ff;--gold:#ffd166;--red:#ff8292;--green:#80ed99}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#172448 0%,var(--bg) 55%);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;min-height:100vh}
button,input,select{font:inherit}button{cursor:pointer;border:0;border-radius:12px;padding:11px 15px;font-weight:750;transition:transform .12s,filter .12s}button:hover{filter:brightness(1.08);transform:translateY(-1px)}button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--cyan);outline-offset:2px}
.wrap{max-width:1180px;margin:auto;padding:24px 18px 42px}.top{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:20px}.brand{display:flex;gap:12px;align-items:center}.logo{width:48px;height:48px;display:grid;place-items:center;border-radius:15px;background:linear-gradient(135deg,var(--cyan),var(--blue));color:#081125;font-size:24px;font-weight:1000}.eyebrow{color:var(--cyan);text-transform:uppercase;letter-spacing:.15em;font-size:11px;font-weight:900}.brand h1{font-size:clamp(23px,4vw,32px);margin:2px 0 0;letter-spacing:-.04em}.stats{display:flex;gap:9px;flex-wrap:wrap}.pill{border:1px solid var(--line);background:#111a2d;padding:10px 13px;border-radius:13px;min-width:90px}.pill small{display:block;color:var(--muted);font-size:11px}.pill strong{font-size:17px}.layout{display:grid;grid-template-columns:260px minmax(0,1fr);gap:18px}.panel{background:linear-gradient(180deg,rgba(25,35,59,.97),rgba(17,25,44,.97));border:1px solid var(--line);border-radius:20px;box-shadow:0 16px 50px #0002}.sidebar{padding:17px;height:max-content}.section-label{font-size:11px;text-transform:uppercase;letter-spacing:.13em;color:var(--muted);font-weight:850;margin:4px 0 11px}.topic-list{display:grid;gap:8px}.topic{width:100%;text-align:left;background:transparent;color:var(--muted);border:1px solid transparent;display:flex;gap:11px;align-items:center;padding:12px}.topic .emoji{font-size:20px;width:26px;text-align:center}.topic.active{background:#263858;border-color:#47618e;color:var(--text)}.topic span:last-child{display:block}.topic small{display:block;color:var(--muted);font-size:11px;font-weight:500;margin-top:3px}.side-note{margin-top:17px;padding:13px;background:#0e172a;border:1px solid var(--line);border-radius:14px;color:var(--muted);font-size:12px;line-height:1.5}.main{padding:clamp(17px,3vw,28px);min-width:0}.quest-top{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.tag{display:inline-flex;align-items:center;gap:6px;background:#233453;border:1px solid #3b5279;color:#cddaff;border-radius:99px;padding:6px 10px;font-size:11px;font-weight:850;text-transform:uppercase;letter-spacing:.07em}.progress-area{margin:19px 0 23px}.progress-meta{display:flex;justify-content:space-between;gap:12px;font-size:12px;color:var(--muted);margin-bottom:8px}.bar{height:8px;background:#0b1325;border-radius:20px;overflow:hidden;border:1px solid #253451}.bar>div{height:100%;width:0;background:linear-gradient(90deg,var(--cyan),var(--blue));border-radius:20px;transition:width .3s}.question{font-size:clamp(20px,3vw,28px);line-height:1.35;letter-spacing:-.025em;margin:0 0 12px}.context{color:var(--muted);line-height:1.6;margin:0 0 20px;font-size:14px}.formula-card{background:#0c1528;border:1px solid #2d4267;border-radius:15px;padding:15px 16px;margin:0 0 20px}.formula-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:8px}.formula-head strong{font-size:12px;text-transform:uppercase;letter-spacing:.1em;color:var(--cyan)}.formula-equation{font-size:clamp(19px,3vw,25px);font-weight:850;letter-spacing:.01em;margin:6px 0 7px}.formula-desc{font-size:12px;color:var(--muted);line-height:1.5}.tiny-btn{padding:6px 9px;background:#253655;color:var(--text);font-size:11px;border:1px solid #3a5279}.answer-area{display:flex;gap:9px;flex-wrap:wrap}.answer-area input{flex:1;min-width:160px;background:#0c1426;border:1px solid #344565;color:var(--text);border-radius:12px;padding:13px 14px}.primary{background:linear-gradient(135deg,var(--cyan),#8cfff0);color:#071326}.secondary{background:#263653;color:var(--text);border:1px solid #405477}.feedback{display:none;margin-top:14px;padding:13px 15px;border-radius:13px;line-height:1.5;font-size:14px}.feedback.show{display:block}.feedback.good{background:#123326;border:1px solid #286b4b;color:#c9ffdd}.feedback.bad{background:#381c2b;border:1px solid #7a344e;color:#ffd4dd}.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:17px}.bottom-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:18px}.mini{padding:17px}.mini h3{font-size:14px;margin:0 0 9px}.mini p{font-size:12px;line-height:1.55;color:var(--muted);margin:0}.formula-collection{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px}.formula-chip{font-size:11px;color:#cddaff;background:#1b2b48;border:1px solid #344c72;padding:7px 9px;border-radius:9px}.formula-chip.hidden{color:#7785a2;background:#111a2b;border-style:dashed}.toast{position:fixed;right:18px;bottom:18px;background:#182743;border:1px solid #3b5279;padding:12px 16px;border-radius:13px;box-shadow:0 10px 30px #0005;display:none}.toast.show{display:block;animation:fade .25s}@keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}.foot{color:#8291af;text-align:center;font-size:11px;margin-top:18px}.reset{font-size:11px;color:var(--muted);background:transparent;padding:8px}.modal-note{font-size:12px;color:var(--muted);margin-top:9px}
@media(max-width:780px){.layout{grid-template-columns:1fr}.sidebar{padding:13px}.topic-list{grid-template-columns:repeat(2,minmax(0,1fr))}.topic{padding:9px}.side-note{display:none}.bottom-grid{grid-template-columns:1fr}.stats{width:100%}.pill{flex:1}}

